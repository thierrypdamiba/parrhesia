{
  "name": "parrhesia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p .",
    "test": "node scripts/test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test && npm run tools:doc && npm run build",
    "tools:doc": "node --import tsx scripts/tools-doc.mjs",
    "tools:doc:write": "node --import tsx scripts/tools-doc.mjs --write",
    "evals:schema": "node --import tsx scripts/export-tool-schema.mjs",
    "evals:smoke": "npx webmcp-evals@0.0.4 smoke -u \"${URL:-http://localhost:3101}/?judge=1\" -e evals/parrhesia.smoke.json -v",
    "evals:api": "node scripts/smoke-letter.mjs \"${URL:-http://localhost:3101}\"",
    "evals:local": "npx webmcp-evals@0.0.4 local -t evals/schema.json -e evals/parrhesia.evals.json"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@openai/sites-vite-plugin": "^0.1.0 || ^0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.6",
    "jiti": "^2.7.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  }
}
